GEMINI_API_KEY=        # aistudio.google.com -- optional; without it the vision tool reports "unavailable"
GROQ_API_KEY=          # console.groq.com

# AWS deploy scripts (or leave empty and use `aws configure`)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Set by the ECS task definition in AWS; only needed to run the worker against real AWS locally
S3_BUCKET_NAME=
SQS_QUEUE_URL=
DYNAMODB_TABLE_NAME=
MAX_RALLIES=           # optional cap on rallies per job

# Set to the stack's ApiUrl output to point a local Streamlit at the AWS backend
SHUTTLECAST_API_URL=
